# Backend Environment Configuration

# Server
PORT=3002
NODE_ENV=development
REQUIRE_DB_ON_BOOT=false

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173,http://localhost:5174
ALLOWED_ORIGINS=

# Public backend base URL (used for local media URLs)
BACKEND_URL=http://localhost:3002
BACKEND_PUBLIC_URL=http://localhost:3002

# Database
DATABASE_URL=postgresql://localhost:5432/branching_movie_creator

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Media storage
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=storage

# AWS S3 (optional for media storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=im-media
S3_ENDPOINT= # For MinIO or other S3-compatible storage

# FFmpeg
FFMPEG_PATH= # Path to ffmpeg binary (optional)
